# Copy this file to .env and fill in your own values. Never commit .env.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/tdub?retryWrites=true&w=majority
ADMIN_PASSWORD=change-me-to-a-long-random-password
PORT=5000
# Your Cloudflare Pages domain(s), comma-separated. Wildcards allowed for preview builds.
ALLOWED_ORIGINS=https://tdub.pages.dev,https://*.tdub.pages.dev,http://localhost:8080
